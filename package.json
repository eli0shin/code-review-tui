{
  "name": "code-review-tui",
  "version": "0.2.2",
  "description": "A terminal interface for GitHub pull request reviews",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "bun build src/cli.tsx --compile --outfile review",
    "dev": "bun run src/cli.tsx",
    "typecheck": "bun tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "test": "bun test",
    "test:watch": "bun test tests/ --watch",
    "prepare": "husky"
  },
  "dependencies": {
    "@commander-js/extra-typings": "^14.0.0",
    "@opentui/core": "^0.5.6",
    "@opentui/react": "^0.5.6",
    "@tanstack/react-query": "^5.101.4",
    "commander": "^14.0.2",
    "react": "^19.2.4"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^0.5.2",
    "@changesets/cli": "^2.29.8",
    "@types/node": "^25.0.3",
    "@types/react": "^19.2.14",
    "bun-types": "^1.3.5",
    "eslint": "^9.39.2",
    "eslint-for-ai": "^1.0.12",
    "eslint-import-resolver-typescript": "^4.4.4",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "prettier": "^3.7.4",
    "typescript": "^5.9.3",
    "yaml": "^2.8.2"
  },
  "author": "@eli0shin",
  "license": "MIT",
  "lint-staged": {
    "*.{ts,tsx,js,mjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  }
}
